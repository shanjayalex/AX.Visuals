# Public site URL (used for SEO, sitemap, OG images)
NEXT_PUBLIC_SITE_URL=https://axvisuals.lk

# Resend — booking emails (https://resend.com). Without a key, bookings are logged to the server console.
RESEND_API_KEY=
EMAIL_FROM="AX.Visuals <bookings@axvisuals.lk>"
STUDIO_EMAIL=shanjayalex19@gmail.com

# PayHere — 50% advance payments (https://www.payhere.lk). Leave blank to take requests only.
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
# "false" = live checkout; anything else = sandbox
PAYHERE_SANDBOX=true

# Google Calendar — availability + tentative holds (service account).
# Share the studio calendar with the service-account email ("Make changes to events").
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID=
